# Optional layer for compose.yaml: attaches Workers to the external Docker
# network of a LiteLLM gateway, so a gateway `url` naming a Docker service
# (for example `http://litellm:4000`) resolves. The gateway is separate
# infrastructure with its own compose project; this file only joins its
# network and never starts it. Only Worker services join it: the `agent`
# one-off seat runs static `config validate` (no gateway needed) and
# `validate` checks the target checkout on the default network.
#
# Enabled from the env file, so the usual commands stay unchanged:
#   COMPOSE_FILE=compose.yaml:compose.coding-agent.litellm.yaml
#   GATEWAY_NETWORK=<the gateway's network name>
# Without COMPOSE_FILE, `docker compose` reads compose.yaml alone and the
# Workers keep only the project's default network. A gateway `url` that is a
# host URL rather than a Docker service needs no overlay: leave COMPOSE_FILE
# unset.
#
# List every Worker that uses a gateway pin with a service-name `url` (its
# Workflow's pin or, for `triage`, its Advisor pin), and only those: delete
# the `worker` entry or the `worker-2` block (worker-2-begin through
# worker-2-end) when that Worker's pins are all direct, and the
# `worker-2` block for a single Worker. A Worker missing here cannot reach
# the gateway. Do not reuse compose.litellm.yaml here: it attaches services
# named `agent` and `agent-<n>`, and on this backend `agent` is the
# unlabelled one-off seat, not a Worker.
services:
  worker:
    networks:
      - default
      - gateway
  # worker-2-begin
  worker-2:
    networks:
      - default
      - gateway
  # worker-2-end

networks:
  gateway:
    name: ${GATEWAY_NETWORK:?set GATEWAY_NETWORK to the LiteLLM gateway's network}
    external: true
