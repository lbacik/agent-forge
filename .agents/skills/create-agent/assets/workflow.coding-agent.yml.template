# yaml-language-server: $schema=https://raw.githubusercontent.com/lbacik/coding-agent/main/schemas/workflow-v3.schema.json
# Workflow Configuration (`version: 3`) for the coding-agent instance
# dedicated to {{OWNER}}/{{REPO}}: one `implement` Workflow (issue in, pull
# request out). Rendered by the create-agent skill from this template; the
# operator guide is coding-agent's docs/ops/workflow-configuration.md, and
# the step-workflow runtime contract is the authority. This file is baked
# into the derived image (see the instance Dockerfile), never mounted: any
# edit needs `docker compose build` before the container is recreated, and
# the build itself re-validates, re-prepares and re-verifies the package.
# Validate edits with
#   docker compose run --rm agent config validate \
#     --config /etc/coding-agent/workflow.yml --workflow implement
# with no secrets set: `config validate` is static, it checks the whole file
# without opening an Attempt or writing to GitHub.
#
# `version: 2` files are refused with a migration diagnostic (coding-agent
# 0.3.0 made `version: 3` the only accepted format): keep `version: 3` and
# the `skills:` block below. A missing `skills` field means an empty bundle,
# so every static `skill:` reference below names a declared member, and every
# member needs a reviewed entry in the workflow directory's
# `skill-policy.json` (copied verbatim from the CODING_AGENT_REF checkout's
# `docker/deployment/skill-policy.json`; the skill never writes or approves
# policy entries, and a changed membership or source ref means the operator
# re-reviews the policy first).
#
# One Worker runs one Workflow. Editing this file affects the next Attempt,
# never one already open. Values that are credentials never appear here:
# `target.token-env` and each model's `api-key-env` name environment
# variables only; the values live in `.env`. A value that looks like a
# secret where a name belongs fails validation.

version: 3

target:
  kind: github
  repository: {{OWNER}}/{{REPO}}
  base-branch: {{BASE_BRANCH}}
  token-env: GITHUB_TOKEN

models:
  # The Attempt's one Pinned Model: exactly one of a direct `provider` pin or
  # a `gateway` pin through a Model Gateway (coding-agent
  # `docs/ops/workflow-configuration.md`, "Gateway pins", at
  # CODING_AGENT_REF). The skill renders one variant below and deletes the
  # other; a file carrying both is a duplicate `main` key. The context window
  # and the per-request output cap of a direct pin stay in code; a gateway pin
  # carries its own `output-cap-tokens` and `context-threshold-tokens`, and a
  # direct pin naming either key is refused. `target.token-env` and each
  # model's `api-key-env` name environment variables only; the values live in
  # `.env`. Prices (`prices-usd-per-mtok`: `input`, `output`, `cache-read`,
  # `cache-write`) come from the operator — confirm them (defaults are the
  # code-owned table's public list pricing) — because the pin's configured
  # prices are the Worker's only cost authority.
  main:
    # Direct provider pin: delete the lines from direct-pin-begin through
    # direct-pin-end for a gateway pin.
    # direct-pin-begin
    provider: {{PROVIDER}}
    model: {{MODEL}}
    endpoint: {{ENDPOINT}}
    effort: medium
    api-key-env: {{API_KEY_ENV}}
    prices-usd-per-mtok: {input: {{PRICE_INPUT}}, output: {{PRICE_OUTPUT}}, cache-read: {{PRICE_CACHE_READ}}, cache-write: {{PRICE_CACHE_WRITE}}}
    # direct-pin-end
    # Gateway pin variant: for a LiteLLM gateway pin, delete the direct pin
    # above and uncomment the block from gateway-pin-begin through
    # gateway-pin-end. `kind` is the gateway kind (today only `litellm`);
    # `url` is the gateway's literal URL — prefer the service name on the
    # shared gateway network (`http://litellm:4000`), which stays the same
    # across Docker contexts; a host URL is also accepted. There is no
    # `url-env` at the documented ref (proposed upstream, not available), so
    # the address is baked into the image. `model` is the gateway's L1 alias,
    # the name the gateway reports in `x-litellm-model-group`. `effort` is
    # low, medium or high. `output-cap-tokens` and
    # `context-threshold-tokens` are the pin's own output cap and
    # context-window threshold (the threshold triggers Context-Window
    # Handoffs, bounded per step by the code-owned handoff cap, and must
    # exceed the code-owned safety margin plus request overhead): ask the
    # operator for both. For a Meta model, which has no cache-write premium,
    # set `cache-write` equal to `input` (a gateway response without
    # `cache_write_tokens` is priced at max(`input`, `cache-write`)).
    # gateway-pin-begin
    # gateway: {kind: litellm, url: {{GATEWAY_URL}}}
    # model: {{GATEWAY_MODEL}}
    # endpoint: responses
    # effort: {{GATEWAY_EFFORT}}
    # api-key-env: {{GATEWAY_API_KEY_ENV}}
    # output-cap-tokens: {{GATEWAY_OUTPUT_CAP_TOKENS}}
    # context-threshold-tokens: {{GATEWAY_CONTEXT_THRESHOLD_TOKENS}}
    # prices-usd-per-mtok: {input: {{GATEWAY_PRICE_INPUT}}, output: {{GATEWAY_PRICE_OUTPUT}}, cache-read: {{GATEWAY_PRICE_CACHE_READ}}, cache-write: {{GATEWAY_PRICE_CACHE_WRITE}}}
    # gateway-pin-end

# Skill Bundle membership: the reference deployment's selection
# (coding-agent's `docker/deployment/workflow.yml` at CODING_AGENT_REF):
# the four established upstream skills at one recorded commit. The skill
# copies the matching reviewed `skill-policy.json` verbatim from the same
# checkout (`docker/deployment/skill-policy.json`) into the instance's
# `workflow/` directory beside this file. A different membership or source
# ref means the operator re-reviews the policy first.
skills:
  - source: git+https://github.com/mattpocock/skills.git
    ref: 3cca18b368ae95cdbdebbff572ccafa662551015
    include: [implement, tdd, code-review, codebase-design]

worker:
  poll-interval-seconds: 60             # idle sleep between sweeps (spends the owner's rate limit)
  shutdown-grace-seconds: 30            # time to finalise after SIGTERM; keep below compose.yaml's stop_grace_period (60s)

workflows:

  # ---------------------------------------------------------------------------
  # Implementation: issue in, pull request out.
  # Policy expressed here, not in the runtime: readiness first, tests via the
  # Validation Contract, a separate self-review before publishing, a PR only
  # when validation passed on the pushed revision.
  # ---------------------------------------------------------------------------
  implement:
    model: main                         # the Attempt's one Pinned Model
    input:
      type: issue
      label: {{SELECTION_LABEL}}        # Selection Label (human-applied, checked)
      exclude: [ready-for-human, wontfix]
      skip-open-agent-pr: true          # skip an issue whose own agent PR is still open
    limits:                             # Attempt Ceiling (mandatory, all four meters)
      cost-usd: {{LIMIT_COST_USD}}
      tokens: {{LIMIT_TOKENS}}
      tool-calls: {{LIMIT_TOOL_CALLS}}
      wall-clock-minutes: {{LIMIT_WALL_CLOCK_MINUTES}}
    max-parallel-subagents: 2
    outcomes:                           # end labels per Terminal Outcome (runtime applies them)
      blocked: {labels: [ready-for-human]}
      unfinished: {labels: [ready-for-human]}
      failed: {labels: [ready-for-human]}
      internal-failure: {labels: [ready-for-human]}

    start: preflight
    defaults:
      max-executions: 1
      routes:                           # only runtime-reserved results may appear here
        error: hard-handoff
        limit-exceeded: hard-handoff

    steps:

      preflight:                                    # role: Preflight
        operation: check-readiness
        routes:
          ready: process
          not-ready: {end: blocked}

      process:                                      # role: Process
        agent:
          instructions:
            - skill: implement
            - prompt: prompts/implement-policy.md
          tools: [workspace-read, workspace-write, shell, tests, subagents]
          inputs:
            - optional: validate.facts              # why the last validation failed
            - optional: self-review.changes-needed.findings
          results:
            done:
              criteria: {list: evidence-ref}        # each test id must have passed on the current tree
              summary: document
            blocked:
              reason: document
        max-executions: 3
        # Step Allowance, shared by all three executions: must fit in the Work
        # Pool (Attempt Ceiling minus the `ai-handoff` reserve, per meter), or
        # validation refuses it.
        limits: {cost-usd: {{PROCESS_LIMIT_COST_USD}}}
        routes:
          done: validate
          blocked: explain-blocked
          limit-exceeded: ai-handoff                # only Process gets the AI-assisted Handoff

      validate:
        operation: run-validation
        max-executions: 3
        routes:
          passed: self-review
          failed: process

      self-review:
        agent:
          instructions:
            - skill: code-review
          tools: [workspace-read, subagents]
          inputs:
            - process.done.summary
          results:
            approved: {}
            changes-needed:
              findings: document
        max-executions: 2
        # Step Allowance: must fit in the Work Pool (see `process` above).
        limits: {cost-usd: {{SELF_REVIEW_LIMIT_COST_USD}}}
        routes:
          approved: push
          changes-needed: process

      push:                                         # role: Finish
        operation: commit-and-push
        routes:
          pushed: open-pr
          no-changes: {end: blocked}

      open-pr:
        operation: open-pull-request              # title: fixed runtime template over the issue title
        with:
          body: process.done.summary
          draft: false
          requires: [run-validation: passed]
        routes:
          opened: {end: completed}
          already-open: {end: completed}
          requirement-unmet: hard-handoff

      explain-blocked:
        operation: post-comment
        with:
          body: process.blocked.reason
        routes:
          posted: {end: blocked}

      ai-handoff:                                   # role: Handoff (AI-assisted)
        agent:
          instructions:
            - prompt: prompts/handoff.md
          tools: [workspace-read]
          inputs:
            - process.facts
          results:
            handoff:
              note: document
        # Reserved Step: a complete allowance carved out of the Attempt Ceiling, so
        # the Work Pool (ceiling minus this reserve, per meter) is smaller than
        # the ceiling on every meter. Every non-reserved Step Allowance
        # (`process`, `self-review`) must fit in that Work Pool, or validation
        # refuses it: the skill checks the fit before writing this file and asks
        # the operator for new allowances or a higher ceiling instead of scaling
        # them itself.
        reserved: true
        limits: {cost-usd: 1, tokens: 150000, tool-calls: 30, wall-clock-minutes: 5}
        routes:
          handoff: handoff-push

      handoff-push:
        operation: commit-and-push
        routes:
          pushed: handoff-comment
          no-changes: handoff-comment

      handoff-comment:
        operation: post-comment
        with:
          body: ai-handoff.handoff.note
        routes:
          posted: {end: unfinished}

      hard-handoff:                                 # role: Handoff (Hard, no model)
        operation: commit-and-push
        routes:
          pushed: {end: unfinished}
          no-changes: {end: unfinished}
          error: {end: failed}
          limit-exceeded: {end: failed}             # must override the default (no self-cycle)
