# Optional layer for compose.yaml: attaches the worker to the external Docker
# network of a LiteLLM gateway, so a gateway `url` naming a Docker service
# (for example `http://litellm:4000`) resolves. The gateway is separate
# infrastructure with its own compose project; this file only joins its
# network and never starts it. Only the worker joins it: the `agent` one-off
# seat runs static `config validate` (no gateway needed) and `validate`
# checks the target checkout on the default network.
#
# Enabled from the env file, so the usual commands stay unchanged:
#   COMPOSE_FILE=compose.yaml:compose.coding-agent.litellm.yaml
#   GATEWAY_NETWORK=<the gateway's network name>
# Without COMPOSE_FILE, `docker compose` reads compose.yaml alone and the
# worker keeps only its project's default network. A gateway `url` that is a
# host URL rather than a Docker service needs no overlay: leave COMPOSE_FILE
# unset.
#
# There is exactly one Worker on this backend (see
# references/coding-agent.md), so this file lists only `worker`. Do not reuse
# compose.litellm.yaml here: it attaches services named `agent` and
# `agent-<n>`, and on this backend `agent` is the unlabelled one-off seat,
# not the Worker.
services:
  worker:
    networks:
      - default
      - gateway

networks:
  gateway:
    name: ${GATEWAY_NETWORK:?set GATEWAY_NETWORK to the LiteLLM gateway's network}
    external: true
