# Copy to .env and fill in before `docker compose up --build`.
# Every operator setting of simple-coding-agent v0.4.4 appears below;
# commented-out keys keep the upstream default. Upstream reference:
# https://github.com/lbacik/simple-coding-agent/blob/v0.4.4/.env.example

# Fine-grained PAT with access to {{OWNER}}/{{REPO}} (contents,
# pull-requests, issues: read & write).
GITHUB_TOKEN=
# Model credential for the default (Meta) backend. MODEL_API_KEY, if set,
# takes precedence; one of the two must be set. See "Model backend" below.
META_API_KEY=
TARGET_REPO={{OWNER}}/{{REPO}}

# The profile is baked into the image (see Dockerfile), not read from the repo.
PROFILE_PATH=/opt/agent-profile/simple-coding-agent-profile.yml

# Which commit of https://github.com/lbacik/simple-coding-agent to build the
# image from (branch, tag, or commit SHA; see compose.yaml's agent-src
# context). Default main tracks upstream; pin a tag to freeze the agent's
# code, then `docker compose build` to rebuild against it — no other file
# needs editing. The runtime (claude-agent-sdk and the Claude Code CLI
# bundled in it) follows the same ref: nothing to update here when it changes.
AGENT_SRC_REF={{AGENT_SRC_REF}}

MAX_BUDGET_USD={{MAX_BUDGET_USD}}
MAX_TURNS={{MAX_TURNS}}

# Token budget per attempt; reaching it stops the attempt (hard ceiling).
# Before that the agent requests a cooperative handoff at the soft threshold,
# the earlier of two rules computed from the main thread's latest context size
# (AGENT_SRC_REF v0.4.3+):
#   soft = min(MAX_BUDGET_TOKENS * (1 - SOFT_THRESHOLD_PERCENTAGE),
#              MAX_BUDGET_TOKENS - (HANDOFF_RESERVE_TURNS + 1) * main_context_tokens)
# The remainder must cover the handoff turns, each of which re-counts the whole
# context (~150k late in a run). SOFT_THRESHOLD_PERCENTAGE is in (0, 1);
# HANDOFF_RESERVE_TURNS is an integer 1-20 (default 6).
# MAX_BUDGET_USD, only a looser SDK circuit breaker, must stay
# >= MAX_BUDGET_TOKENS * $5/MTok (Meta rates,
# which apply to every MODEL_NAME priced in the image's managed-settings.json,
# also through a LiteLLM gateway; other models are priced at the CLI's own,
# higher rates — raise it).
MAX_BUDGET_TOKENS={{MAX_BUDGET_TOKENS}}
SOFT_THRESHOLD_PERCENTAGE={{SOFT_THRESHOLD_PERCENTAGE}}
# HANDOFF_RESERVE_TURNS=6

# Optional operator settings (AGENT_SRC_REF v0.4.4). Commented out values are
# the upstream defaults; uncomment only to change one.
# Seconds between issue polls.
# POLL_INTERVAL=60
# CRITICAL, ERROR, WARNING, INFO or DEBUG.
# LOG_LEVEL=INFO
# Wall-clock limit (seconds) of one model session; reaching it gets one
# best-effort handoff follow-up, as with MAX_TURNS.
# MODEL_TIMEOUT=3600
# Single deadline (seconds) covering the push and pull-request path.
# PUBLISH_TIMEOUT=120
# Attempts of transient GitHub and push operations (exponential backoff);
# model work is never retried. An exhausted failure is an infrastructure_error.
# MAX_RETRIES=3
# Consecutive infrastructure_error attempts after which the process exits
# with status 1. The count persists in $DATA_DIR/state/consecutive_errors.json:
# a restart alone does not reset it.
# MAX_CONSECUTIVE_ERRORS=3
# DATA_DIR is set to the /data volume by the Dockerfile; do not set it here.
# The persistent clone defaults to $DATA_DIR/repo.
# CLONE_DIR=/data/repo
# Extra PATH directories (colon-separated) prepended to the deliberately
# minimal PATH of the profile's setup/check commands.
# PROFILE_EXTRA_PATH=
# true also loads the target repository's project settings and skills
# (hooks stay disabled, but apiKeyHelper, settings env entries and
# project-skill allowed-tools remain exposed). Enable only for trusted
# repositories.
# AGENT_TRUST_PROJECT_SETTINGS=false
# Review findings that block publication. An explicitly empty value selects
# the test-only review gate.
# REVIEW_BLOCKING_SEVERITIES=must-fix
# Leave CLAUDE_AGENT_SDK_VERSION unset: the runtime (claude-agent-sdk and its
# bundled CLI) follows AGENT_SRC_REF, see the Dockerfile.

# Pull-request auto-merge (AGENT_SRC_REF v0.4.0+). Off by default: the agent
# only opens a PR for a complete implementation and a human merges it.
# - true: right after opening the PR the orchestrator (never the model)
#   enables GitHub's native auto-merge with PR_MERGE_METHOD, so GitHub merges
#   once the base branch's protection rules are met, or merges directly when
#   the PR is already mergeable.
# - label: the same, but only for issues that carried the `agent-auto-merge`
#   label at claim time (only collaborators with write access may apply it;
#   a label added later never counts). Unlabelled issues still get their PR.
# Any other value fails startup. A merge failure never changes a complete
# outcome; it is only reported in the issue result comment.
# Prerequisites: turn on "Allow auto-merge" in {{OWNER}}/{{REPO}}'s settings
# (otherwise every merge step fails) and protect the base branch with the
# required checks, plus required reviews if a human must still approve.
# WARNING: without branch protection, auto-merged PRs land with no review.
# The PAT scopes above are enough. See the upstream
# docs/agents/operator-onboarding.md before enabling.
# PR_AUTO_MERGE=false
# merge, squash or rebase; used by both the auto-merge and direct-merge paths.
# PR_MERGE_METHOD=merge

# Automatic continuation of handoff releases (AGENT_SRC_REF v0.4.3+). With the
# default 0, continuing a `round-finished` issue always needs a human decision
# (re-applying `ready-for-agent`). With N > 0, the agent picks up a
# `round-finished` issue on its own, ahead of new `ready-for-agent` work, up to
# N automatic continuations in a row; a human requeue resets the count and
# grants another N rounds, and removing `round-finished` stops the sequence at
# any time. Every round is a new attempt with its own MAX_BUDGET_USD, so N
# multiplies the worst-case cost per issue. A negative or non-integer value
# fails startup. Operator-only: the repository profile refuses this key, so an
# agent-written PR can never raise its own round limit. See the upstream
# docs/adr/0005-automatic-continuation-budget.md.
# MAX_AUTO_CONTINUATIONS=0

# Handoff comment mode. With the default `link`, the first handoff creates one
# short shared comment per issue and later routine handoffs update its hidden
# record without posting an individual result comment or copying the note body
# into GitHub; the visible branch link keeps showing the latest note. Set
# `verbose` to keep the historical per-attempt handoff result comments
# (including the note body) for troubleshooting. Both modes share the same
# bookkeeping and recovery, still post explicit notifications when human
# action is needed, and leave existing comments untouched when switching.
# Operator-only: the repository profile refuses this key.
# HANDOFF_COMMENT_MODE=link

# Conflict requeue of published pull requests (AGENT_SRC_REF v0.6.0+). With
# the default 0, the `merge-conflict` label is not part of the queue, no
# pull-request query runs, and a labelled issue waits untouched. With N > 0,
# every poll reads the open pull requests and labels an issue `merge-conflict`
# when its `agent/issue-N` branch reports CONFLICTING (a human may also apply
# the label). Such an issue is claimed ahead of automatic continuations and
# new work; the conflict attempt rebases the branch onto the base, runs setup
# plus one profile check and force-pushes only when green, with no model call.
# After N consecutive failed attempts on one issue the agent adds
# `ready-for-human` and never removes it; a human removing it requeues the
# issue with the full budget. A pool of workers sharing one account may also
# set PEER_LOGINS (comma- or space-separated) so their conflict comments count
# toward the budget. A negative or non-integer value fails startup.
# Operator-only: the repository profile refuses this key. See the upstream
# docs/adr/0007-conflict-attempt-budget.md.
# MAX_CONFLICT_ATTEMPTS=0

# Alternative configurations (e.g. .env.claude or .env.litellm for another
# model backend): copy this file, change what differs and set AGENT_ENV_FILE
# to the copy's own name, then pass it with
# `docker compose --env-file .env.claude ...` to every command. Without AGENT_ENV_FILE the container would still load .env (see
# compose.yaml). Leave it unset here.
# AGENT_ENV_FILE=.env.claude

# Model backend (AGENT_SRC_REF v0.3.2+). Defaults keep the Meta backend, so
# leave these commented out unless switching. Keep unused keys commented, not
# empty: an empty MODEL_BASE_URL means "no base URL" (direct Anthropic API) and
# an empty MODEL_AUTH_MODE fails startup.
# MODEL_BASE_URL=https://api.meta.ai
# auth_token (Bearer, Meta) or api_key (x-api-key, Anthropic API).
# MODEL_AUTH_MODE=auth_token
# MODEL_API_KEY=
# Stalled-stream timeout, passed as CLAUDE_STREAM_IDLE_TIMEOUT_MS.
# MODEL_STREAM_IDLE_TIMEOUT_MS=60000
#
# Anthropic API directly (testing). MODEL_NAME must be the full model ID, not
# an alias: a mismatch with the model the API reports is an infrastructure
# error.
# MODEL_BASE_URL=
# MODEL_AUTH_MODE=api_key
# MODEL_API_KEY=sk-ant-...
# MODEL_NAME=claude-sonnet-5-5
#
# LiteLLM gateway on a shared Docker network (recommended for muse-* models:
# the gateway restores Meta prompt caching). MODEL_NAME must match a
# model_name in the gateway's config.yaml exactly. MODEL_API_KEY is the
# gateway's LITELLM_MASTER_KEY, not a provider key; META_API_KEY stays empty
# here and lives only in the gateway. COMPOSE_FILE adds compose.litellm.yaml,
# which attaches the agent to GATEWAY_NETWORK.
# COMPOSE_FILE=compose.yaml:compose.litellm.yaml
# GATEWAY_NETWORK=<the gateway's external network>
# MODEL_BASE_URL=http://litellm:4000
# MODEL_AUTH_MODE=auth_token
# MODEL_API_KEY=sk-...
# MODEL_NAME=muse-spark-1.3-contributor

# Claude Code CLI context window and auto-compaction. Not simple-coding-agent
# settings: the CLI reads them from the container environment, which the
# agent passes through. The CLI does not recognise muse-* models and assumes
# a 200K window for them, compacting the context against it.
# CLAUDE_CODE_MAX_CONTEXT_TOKENS sets the model's real window (1M), and
# CLAUDE_CODE_AUTO_COMPACT_WINDOW (100000-1000000, capped at that window) is
# the context size at which the CLI compacts. A larger context raises every
# turn's token count and, through HANDOFF_RESERVE_TURNS, brings the soft
# threshold forward. Comment both out for claude-* models, whose window the
# CLI knows.
CLAUDE_CODE_MAX_CONTEXT_TOKENS=1000000
CLAUDE_CODE_AUTO_COMPACT_WINDOW=400000
