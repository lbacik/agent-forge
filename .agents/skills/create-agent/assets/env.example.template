# Copy to .env and fill in before `docker compose up --build`.
# See https://github.com/lbacik/simple-coding-agent/blob/main/.env.example for
# the full list of optional settings (POLL_INTERVAL, MODEL_NAME,
# REVIEW_BLOCKING_SEVERITIES, MODEL_* backend settings, ...).

# Fine-grained PAT with access to {{OWNER}}/{{REPO}} (contents,
# pull-requests, issues: read & write).
GITHUB_TOKEN=
# Model credential for the default (Meta) backend. MODEL_API_KEY, if set,
# takes precedence; one of the two must be set. See "Model backend" below.
META_API_KEY=
TARGET_REPO={{OWNER}}/{{REPO}}

# The profile is baked into the image (see Dockerfile), not read from the repo.
PROFILE_PATH=/opt/agent-profile/simple-coding-agent-profile.yml

# Which commit of https://github.com/lbacik/simple-coding-agent to build the
# image from (branch, tag, or commit SHA; see compose.yaml's agent-src
# context). Default main tracks upstream; pin a tag to freeze the agent's
# code, then `docker compose build` to rebuild against it — no other file
# needs editing. The runtime (claude-agent-sdk and the Claude Code CLI
# bundled in it) follows the same ref: nothing to update here when it changes.
AGENT_SRC_REF={{AGENT_SRC_REF}}

MAX_BUDGET_USD={{MAX_BUDGET_USD}}
MAX_TURNS={{MAX_TURNS}}

# Token budget per attempt. The soft threshold (handoff request) fires at
# MAX_BUDGET_TOKENS * (1 - SOFT_THRESHOLD_PERCENTAGE); the remainder must cover
# the handoff turns, each of which re-counts the whole context (~150k late in a
# run). MAX_BUDGET_USD must stay >= MAX_BUDGET_TOKENS * $5/MTok (Meta rates,
# which apply to every MODEL_NAME priced in the image's managed-settings.json,
# also through a LiteLLM gateway; other models are priced at the CLI's own,
# higher rates — raise it).
MAX_BUDGET_TOKENS={{MAX_BUDGET_TOKENS}}
SOFT_THRESHOLD_PERCENTAGE={{SOFT_THRESHOLD_PERCENTAGE}}

# Pull-request auto-merge (AGENT_SRC_REF v0.4.0+). Off by default: the agent
# only opens a PR for a complete implementation and a human merges it.
# - true: right after opening the PR the orchestrator (never the model)
#   enables GitHub's native auto-merge with PR_MERGE_METHOD, so GitHub merges
#   once the base branch's protection rules are met, or merges directly when
#   the PR is already mergeable.
# - label: the same, but only for issues that carried the `agent-auto-merge`
#   label at claim time (only collaborators with write access may apply it;
#   a label added later never counts). Unlabelled issues still get their PR.
# Any other value fails startup. A merge failure never changes a complete
# outcome; it is only reported in the issue result comment.
# Prerequisites: turn on "Allow auto-merge" in {{OWNER}}/{{REPO}}'s settings
# (otherwise every merge step fails) and protect the base branch with the
# required checks, plus required reviews if a human must still approve.
# WARNING: without branch protection, auto-merged PRs land with no review.
# The PAT scopes above are enough. See the upstream
# docs/agents/operator-onboarding.md before enabling.
# PR_AUTO_MERGE=false
# merge, squash or rebase; used by both the auto-merge and direct-merge paths.
# PR_MERGE_METHOD=merge

# Automatic continuation of handoff releases (AGENT_SRC_REF v0.4.3+). With the
# default 0, continuing a `round-finished` issue always needs a human decision
# (re-applying `ready-for-agent`). With N > 0, the agent picks up a
# `round-finished` issue on its own, ahead of new `ready-for-agent` work, up to
# N automatic continuations in a row; a human requeue resets the count and
# grants another N rounds, and removing `round-finished` stops the sequence at
# any time. Every round is a new attempt with its own MAX_BUDGET_USD, so N
# multiplies the worst-case cost per issue. A negative or non-integer value
# fails startup. Operator-only: the repository profile refuses this key, so an
# agent-written PR can never raise its own round limit. See the upstream
# docs/adr/0005-automatic-continuation-budget.md.
# MAX_AUTO_CONTINUATIONS=0

# Alternative configurations (e.g. .env.claude or .env.litellm for another
# model backend): copy this file, change what differs and set AGENT_ENV_FILE
# to the copy's own name, then pass it with
# `docker compose --env-file .env.claude ...` to every command. Without AGENT_ENV_FILE the container would still load .env (see
# compose.yaml). Leave it unset here.
# AGENT_ENV_FILE=.env.claude

# Model backend (AGENT_SRC_REF v0.3.2+). Defaults keep the Meta backend, so
# leave these commented out unless switching. Keep unused keys commented, not
# empty: an empty MODEL_BASE_URL means "no base URL" (direct Anthropic API) and
# an empty MODEL_AUTH_MODE fails startup.
# MODEL_BASE_URL=https://api.meta.ai
# auth_token (Bearer, Meta) or api_key (x-api-key, Anthropic API).
# MODEL_AUTH_MODE=auth_token
# MODEL_API_KEY=
# Stalled-stream timeout, passed as CLAUDE_STREAM_IDLE_TIMEOUT_MS.
# MODEL_STREAM_IDLE_TIMEOUT_MS=60000
#
# Anthropic API directly (testing). MODEL_NAME must be the full model ID, not
# an alias: a mismatch with the model the API reports is an infrastructure
# error.
# MODEL_BASE_URL=
# MODEL_AUTH_MODE=api_key
# MODEL_API_KEY=sk-ant-...
# MODEL_NAME=claude-sonnet-5-5
#
# LiteLLM gateway on a shared Docker network (recommended for muse-* models:
# the gateway restores Meta prompt caching). MODEL_NAME must match a
# model_name in the gateway's config.yaml exactly. MODEL_API_KEY is the
# gateway's LITELLM_MASTER_KEY, not a provider key; META_API_KEY stays empty
# here and lives only in the gateway. COMPOSE_FILE adds compose.litellm.yaml,
# which attaches the agent to GATEWAY_NETWORK.
# COMPOSE_FILE=compose.yaml:compose.litellm.yaml
# GATEWAY_NETWORK=<the gateway's external network>
# MODEL_BASE_URL=http://litellm:4000
# MODEL_AUTH_MODE=auth_token
# MODEL_API_KEY=sk-...
# MODEL_NAME=muse-spark-1.3-contributor
