#!/bin/sh
# Fake `docker` for the legacy-helpers test. It replays recorded replies for
# `ps`/`inspect`/`agentctl status` and emulates the volume reads (`exec`/`run`
# `sh -c ...`, `cp`) against fixture files, so the debug-agent helpers run in
# CI with no Docker host and no real agent.
#
# Environment (all set by tests/legacy-helpers.sh):
#   STUB_ARGV_LOG    file every invocation is appended to, as one
#                    `CTX=<docker-context> docker <argv>` record (multi-line
#                    when argv holds a script). The test asserts the helpers'
#                    argv by grepping this log.
#   STUB_SCENARIO_DIR  recorded replies: $STUB_SCENARIO_DIR/<project>/
#                    ps-<service>.txt, ps-PROJECT.txt, inspect-<container>.txt,
#                    exec-agentctl-<container>.txt. A missing reply file for
#                    `ps` means "no such container" (empty output, like a real
#                    daemon); any other missing reply is an error telling the
#                    author which file to record.
#   STUB_VOLUMES_ROOT  fixture volumes: $STUB_VOLUMES_ROOT/<volume> stands in
#                    for /data of that volume (`<project>_agent_data` for the
#                    first Worker, `<project>_data_<n>` for Worker N>=2).
#   STUB_PROJECTS    space-separated compose project names the stub knows
#                    (used to map a container back to its project/volume).
#   DOCKER_CONTEXT   set by the helpers themselves; logged, never contacted.
#
# To extend the stub with new recorded replies without changing the helpers
# (or this fake): add reply files under $STUB_SCENARIO_DIR/<project>/ and, for
# a new project, list it in STUB_PROJECTS. The contract-path checks put
# `agentfleet`, backed by the suite's replaying fake `agentctl`, behind this
# same tests/stub/bin mechanism: `ps` with the contract label serves
# $scene/fleet.json, `inspect` without `-f` serves it as JSON, the per-container
# contract label is read from $scene/<project>/contract-label-<container>.txt,
# fixture from $CONTRACT_FIXTURES_DIR (the pinned tag checkout, never copied):
# identity, command and status/mutation reads via CONTRACT_IDENTITY_FIXTURE,
# CONTRACT_COMMAND_FIXTURE and CONTRACT_STATUS_FIXTURE. A test can pin one
# member's fixture with $scene/contract-<op>-<name>.txt (op one of status,
# identity, command), naming the fixture file; tests without a mapping keep
# the suite-wide defaults. Legacy `agentctl stop|resume|command|next issue|
# handoff` (no --contract flag) replays a recorded text reply per op from
# $scene/<project>/exec-agentctl-<op>-<container>.txt. A bare `ps` (no
# project filter, as the fleet overview's legacy list runs) serves
# $scene/ps-ALL.txt.
#
# This fake never delegates to a real docker: there is no code path here that
# reaches a Docker host.

set -eu

scene=${STUB_SCENARIO_DIR:?STUB_SCENARIO_DIR is not set}
vols=${STUB_VOLUMES_ROOT:?STUB_VOLUMES_ROOT is not set}

# shellcheck disable=SC1091 # resolved at runtime from STUB_LIB, not statically
. "${STUB_LIB:?STUB_LIB is not set}/log-argv.sh"
log_argv docker "$@"

cmd=${1:?usage: stub docker ...}
shift

proj_of_container() {
  best=""
  # shellcheck disable=SC2086 # word-splitting the project list is intended
  for p in $STUB_PROJECTS; do
    case "$1" in
      "$p"-*)
        if [ "${#p}" -gt "${#best}" ]; then best=$p; fi
        ;;
    esac
  done
  printf '%s' "$best"
}

datadir_for_container() {
  p=$(proj_of_container "$1")
  [ -n "$p" ] || {
    stub_fail "stub docker: no recorded reply: unknown project for container $1"
  }
  rest=${1#"$p"-}
  svc=${rest%-1}
  case "$svc" in
    (agent)
      printf '%s' "$vols/$p""_agent_data"
      ;;
    (agent-*)
      n=${svc#agent-}
      printf '%s' "$vols/$p""_data_$n"
      ;;
    (*)
      stub_fail "stub docker: no recorded reply: unknown service for container $1"
      ;;
  esac
}

case "$cmd" in
  (ps)
    proj=""
    svc=""
    contract_ps=0
    for a in "$@"; do
      case "$a" in
        (label=com.docker.compose.project=*) proj=${a#label=com.docker.compose.project=} ;;
        (label=com.docker.compose.service=*) svc=${a#label=com.docker.compose.service=} ;;
        (label=io.github.lbacik.agent-operator.contract*) contract_ps=1 ;;
      esac
    done
    if [ "$contract_ps" -eq 1 ]; then
      # Fleet discovery for agentfleet: list IDs from fleet.json.
      if [ -f "$scene/fleet.json" ]; then
        python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); [print(c["id"]) for c in d.get("containers",[]) if isinstance(c,dict) and "id" in c]' "$scene/fleet.json"
        exit 0
      fi
      exit 0
    fi
    if [ -z "$proj" ]; then
      # Fleet overview legacy list: one ps for every project on the context.
      f="$scene/ps-ALL.txt"
      if [ -f "$f" ]; then
        cat "$f"
      else
        stub_fail "stub docker: no recorded reply: add ps-ALL.txt (empty file means no containers)"
      fi
      exit 0
    fi
    if [ -n "$svc" ]; then
      f="$scene/$proj/ps-$svc.txt"
    else
      f="$scene/$proj/ps-PROJECT.txt"
    fi
    # A missing reply file is a fixture gap, not "no container": record it.
    # An empty reply file means the daemon lists no such container.
    if [ -f "$f" ]; then
      cat "$f"
    else
      stub_fail "stub docker: no recorded reply: add $proj/ps-${svc:-PROJECT}.txt (empty file means no container)"
    fi
    exit 0
    ;;
  (inspect)
    has_format=0
    label_format=0
    for a in "$@"; do
      case "$a" in
        (-f) has_format=1 ;;
        (*Config.Labels*contract*) label_format=1 ;;
      esac
    done
    if [ "$label_format" -eq 1 ]; then
      # Per-container contract label for path selection.
      cont=""
      for a in "$@"; do
        case "$a" in
          (-*|*'{{'*|*'}}'*) ;;
          (*) cont=$a ;;
        esac
      done
      proj=$(proj_of_container "$cont")
      f="$scene/$proj/contract-label-$cont.txt"
      if [ -f "$f" ]; then
        cat "$f"
      else
        printf '\n'
      fi
      exit 0
    fi
    if [ "$has_format" -eq 0 ] && [ -f "$scene/fleet.json" ]; then
      # Fleet discovery inspect: IDs -> JSON array with labels, state, mounts.
      python3 - "$scene/fleet.json" "$@" <<'PY'
import json, sys
fleet_path = sys.argv[1]
ids = sys.argv[2:]
doc = json.load(open(fleet_path))
by_id = {c["id"]: c for c in doc.get("containers", []) if isinstance(c, dict) and "id" in c}
entries = []
for cid in ids:
    d = by_id.get(cid)
    if d is None:
        sys.stderr.write(f"fake docker: no such container: {cid}\n")
        sys.exit(1)
    labels = {
        "io.github.lbacik.agent-operator.contract": str(d.get("contract", "1")),
        "io.github.lbacik.agent-operator.instance": str(d.get("name", "")),
        "io.github.lbacik.agent-operator.backend": str(d.get("backend", "")),
        "io.github.lbacik.agent-operator.exec-user": str(d.get("exec_user", "")),
    }
    if d.get("oneoff") is True:
        labels["com.docker.compose.oneoff"] = "True"
    state = str(d.get("state", "running"))
    mounts = []
    for v in d.get("volumes", []) if isinstance(d.get("volumes"), list) else []:
        if isinstance(v, dict) and v.get("name") and v.get("path"):
            mounts.append({"Type": "volume", "Name": v["name"], "Source": v["name"], "Destination": v["path"]})
    for b in d.get("binds", []) if isinstance(d.get("binds"), list) else []:
        if isinstance(b, dict) and b.get("source") and b.get("path"):
            mounts.append({"Type": "bind", "Source": b["source"], "Destination": b["path"]})
    entries.append({"Id": cid, "Image": str(d.get("image", "example-image")), "Config": {"Labels": labels}, "Mounts": mounts, "State": {"Status": state, "Running": state == "running"}})
sys.stdout.write(json.dumps(entries) + "\n")
PY
      exit 0
    fi
    cont=""
    for a in "$@"; do
      case "$a" in
        (-*) ;;
        (*) cont=$a ;;
      esac
    done
    proj=$(proj_of_container "$cont")
    f="$scene/$proj/inspect-$cont.txt"
    if [ -f "$f" ]; then
      cat "$f"
    else
      stub_fail "stub docker: no recorded reply: add $proj/inspect-$cont.txt"
    fi
    exit 0
    ;;
  (exec|run)
    case " $* " in
      (*"/usr/local/bin/agentctl"*--contract*)
        # Contract agentctl replay for agentfleet (identity/status reads and
        # attempts list/show/export). Identity/status fixtures come from the
        # pinned tag checkout, never copied: CONTRACT_FIXTURES_DIR points at
        # its fixtures/agentctl/, CONTRACT_IDENTITY_FIXTURE /
        # CONTRACT_STATUS_FIXTURE name the files. Attempts list/show pages are
        # read from the scene ($scene/attempts-list.json for the first page,
        # $scene/attempts-list-before-<cursor>.json for later pages,
        # $scene/attempts-show-<id>.json per attempt). Export tars are
        # synthesized from $scene/archive-<id>/ plus $scene/archive-<id>.json
        # (the attempt summary), with exact sizes and sha256 so the client's
        # torn-read verification passes; a sentinel
        # $scene/export-torn-once-<id> makes the first export of that attempt
        # torn to exercise the refetch.
        _fixdir=${CONTRACT_FIXTURES_DIR:-}
        _op=status
        case " $* " in
          (*" identity "*) _op=identity ;;
          (*" attempts list "*|*" attempts ls "*) _op=attlist ;;
          (*" attempts show "*) _op=attshow ;;
          (*" attempts export "*) _op=attexport ;;
          (*" command "*) _op=command ;;
        esac
        case "$_op" in
          (attlist)
            _cursor=""
            _prev=""
            for _a in "$@"; do
              if [ "$_prev" = "--before" ]; then _cursor=$_a; fi
              _prev=$_a
            done
            if [ -z "$_cursor" ]; then
              _f="$scene/attempts-list.json"
            else
              _san=$(printf '%s' "$_cursor" | tr -c 'A-Za-z0-9' '_')
              _f="$scene/attempts-list-before-$_san.json"
            fi
            [ -f "$_f" ] || stub_fail "stub docker: no recorded reply: add $(basename "$_f") for attempts list (cursor '${_cursor:-<first page>}')"
            # Scene pages hold either a raw producer envelope or a pinned
            # harness reply ({argv, exit_code, stdout, stderr}); the helper
            # only ever sees the envelope stdout.
            set +e
            python3 - "$_f" <<'PYEOF'
import base64, json, sys
doc = json.load(open(sys.argv[1]))
if isinstance(doc, dict) and "ok" not in doc and "stdout" in doc:
    enc = doc.get("stdout_base64")
    if isinstance(enc, str) and enc:
        sys.stdout.buffer.write(base64.b64decode(enc))
    else:
        sys.stdout.write(str(doc.get("stdout", "")))
else:
    json.dump(doc, sys.stdout)
    sys.stdout.write("\n")
PYEOF
            _page_code=$?
            set -e
            exit "$_page_code"
            ;;
          (attshow)
            _prev=""
            _aid=""
            for _a in "$@"; do
              if [ "$_prev" = "show" ]; then _aid=$_a; fi
              _prev=$_a
            done
            [ -n "$_aid" ] || stub_fail "stub docker: attempts show without an attempt id"
            _san=$(printf '%s' "$_aid" | tr -c 'A-Za-z0-9' '_')
            _f="$scene/attempts-show-$_san.json"
            [ -f "$_f" ] || stub_fail "stub docker: no recorded reply: add attempts-show-$_san.json for attempt '$_aid'"
            set +e
            python3 - "$_f" <<'PYEOF'
import base64, json, sys
doc = json.load(open(sys.argv[1]))
if isinstance(doc, dict) and "ok" not in doc and "stdout" in doc:
    enc = doc.get("stdout_base64")
    if isinstance(enc, str) and enc:
        sys.stdout.buffer.write(base64.b64decode(enc))
    else:
        sys.stdout.write(str(doc.get("stdout", "")))
else:
    json.dump(doc, sys.stdout)
    sys.stdout.write("\n")
PYEOF
            _show_code=$?
            set -e
            exit "$_show_code"
            ;;
          (attexport)
            _prev=""
            _aid=""
            for _a in "$@"; do
              if [ "$_prev" = "export" ]; then _aid=$_a; fi
              _prev=$_a
            done
            [ -n "$_aid" ] || stub_fail "stub docker: attempts export without an attempt id"
            _san=$(printf '%s' "$_aid" | tr -c 'A-Za-z0-9' '_')
            { [ -f "$scene/archive-$_san.json" ] && [ -d "$scene/archive-$_san" ]; } || \
              stub_fail "stub docker: no recorded reply: add archive-$_san.json and archive-$_san/ for attempt '$_aid'"
            set +e
            STUB_EXPORT_SAFE=$_san STUB_SCENE_DIR=$scene python3 - <<'PYEOF'
import hashlib, io, json, os, sys, tarfile
safe = os.environ["STUB_EXPORT_SAFE"]
scene = os.environ["STUB_SCENE_DIR"]
meta = json.load(open(os.path.join(scene, "archive-%s.json" % safe)))
srcdir = os.path.join(scene, "archive-%s" % safe)
kinds = meta.get("file_kinds", {})
plain = []
for dirpath, dirnames, filenames in os.walk(srcdir):
    dirnames.sort()
    for name in sorted(filenames):
        full = os.path.join(dirpath, name)
        rel = os.path.relpath(full, srcdir)
        with open(full, "rb") as handle:
            plain.append((rel, handle.read()))
torn = False
if os.path.exists(os.path.join(scene, "export-torn-once-%s" % safe)) \
        and not os.path.exists(os.path.join(scene, "export-count-%s" % safe)):
    torn = True
    with open(os.path.join(scene, "export-count-%s" % safe), "w") as handle:
        handle.write("1")
entries = []
blob = {}
first = True
for rel, content in plain:
    spec = kinds.get(rel, {})
    if not isinstance(spec, dict):
        spec = {}
    out = content
    if torn and first:
        first = False
        out = (b"X" if content[:1] != b"X" else b"Y") + content[1:]
    blob[rel] = out
    entries.append({
        "path": rel,
        "kind": spec.get("kind", "other"),
        "media_type": spec.get("media_type", "application/octet-stream"),
        "size": len(content),
        "sha256": hashlib.sha256(content).hexdigest(),
    })
manifest = {"contract": "1.0", "attempt": meta["attempt"], "files": entries}
buf = io.BytesIO()
with tarfile.open(fileobj=buf, mode="w") as archive:
    data = json.dumps(manifest).encode("utf-8")
    info = tarfile.TarInfo("manifest.json")
    info.size = len(data)
    archive.addfile(info, io.BytesIO(data))
    for rel, _content in plain:
        info = tarfile.TarInfo(rel)
        info.size = len(blob[rel])
        archive.addfile(info, io.BytesIO(blob[rel]))
sys.stdout.buffer.write(buf.getvalue())
PYEOF
            _gen_code=$?
            set -e
            exit "$_gen_code"
            ;;
        esac
        if [ "$_op" = identity ]; then
          _fix=${CONTRACT_IDENTITY_FIXTURE:-identity.json}
        elif [ "$_op" = command ]; then
          _fix=${CONTRACT_COMMAND_FIXTURE:-command-found.json}
        else
          _fix=${CONTRACT_STATUS_FIXTURE:-status-active.json}
        fi
        # Per-member override: $scene/contract-<op>-<name>.txt names the
        # fixture for one Fleet member (exec carries the container id, an
        # Offline Read run carries the image; both map through fleet.json).
        # Tests without a mapping keep the suite-wide default above.
        _key=""
        _prev=""
        _want=0
        for _a in "$@"; do
          if [ "$_want" -eq 1 ]; then
            _key=$_a
            _want=0
          elif [ "$_prev" = "--user" ]; then
            _prev="gotuser"
          elif [ "$_prev" = "gotuser" ]; then
            case "$cmd" in
              (exec) _key=$_a ;;
            esac
            _prev=""
          elif [ "$_a" = "/usr/local/bin/agentctl" ] && [ "$cmd" = "run" ]; then
            _want=1
          else
            _prev=$_a
          fi
        done
        _member=""
        if [ -n "$_key" ] && [ -f "$scene/fleet.json" ]; then
          _member=$(python3 - "$scene/fleet.json" "$_key" <<'PYEOF' || true
import json, sys
try:
    doc = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
key = sys.argv[2]
for c in doc.get("containers", []):
    if not isinstance(c, dict):
        continue
    if c.get("id") == key or c.get("image") == key:
        sys.stdout.write(str(c.get("name", "")))
        break
PYEOF
)
        fi
        if [ -n "$_member" ] && [ -f "$scene/contract-$_op-$_member.txt" ]; then
          _fix=$(tr -d '[:space:]' <"$scene/contract-$_op-$_member.txt")
        fi
        if [ -z "$_fixdir" ]; then
          stub_fail "stub docker: CONTRACT_FIXTURES_DIR is not set for contract agentctl replay"
        fi
        set +e
        python3 - "$_fixdir/$_fix" <<'PYEOF'
import base64, json, sys
doc = json.load(open(sys.argv[1]))
enc = doc.get("stdout_base64")
if isinstance(enc, str) and enc:
    sys.stdout.buffer.write(base64.b64decode(enc))
    sys.stdout.buffer.flush()
else:
    sys.stdout.write(str(doc.get("stdout", "")))
sys.stderr.write(str(doc.get("stderr", "")))
sys.exit(int(doc.get("exit_code", 0)))
PYEOF
        _replay_code=$?
        exit "$_replay_code"
        ;;
    esac
    script=""
    take_script=""
    skip_next=0
    prev=""
    pos=""
    vol=""
    for a in "$@"; do
      if [ -n "$take_script" ]; then
        script=$a
        take_script=""
        continue
      fi
      if [ "$skip_next" = 1 ]; then
        if [ "$prev" = "-v" ]; then vol=${a%%:*}; fi
        skip_next=0
        prev=""
        continue
      fi
      case "$a" in
        (-u|-w|--entrypoint) skip_next=1; prev=$a ;;
        (-v) skip_next=1; prev="-v" ;;
        (-c) take_script=1 ;;
        (-*) ;;
        (sh) ;;
        (*) pos="$pos $a" ;;
      esac
    done
    case "$script" in
      (*"agentctl status"*)
        # shellcheck disable=SC2086 # word-splitting one positional is intended
        set -- $pos
        cont=${1:?stub docker: agentctl status without a container}
        proj=$(proj_of_container "$cont")
        f="$scene/$proj/exec-agentctl-$cont.txt"
        if [ -f "$f" ]; then
          cat "$f"
        else
          stub_fail "stub docker: no recorded reply: add $proj/exec-agentctl-$cont.txt"
        fi
        exit 0
        ;;
      (*"/usr/local/bin/agentctl stop"*|*"/usr/local/bin/agentctl resume"*|*"/usr/local/bin/agentctl command "*|*"/usr/local/bin/agentctl next issue"*|*"/usr/local/bin/agentctl handoff"*)
        # Legacy agentctl mutation/lookup replay for the operate-agent
        # consumer suite (no --contract flag anywhere above matched). Reply
        # fixture: $scene/<project>/exec-agentctl-<op>-<container>.txt with
        # <op> one of stop, resume, command, next-issue, handoff.
        case "$script" in
          (*"/usr/local/bin/agentctl stop"*) _lop=stop ;;
          (*"/usr/local/bin/agentctl resume"*) _lop=resume ;;
          (*"/usr/local/bin/agentctl command "*) _lop=command ;;
          (*"/usr/local/bin/agentctl next issue"*) _lop=next-issue ;;
          (*"/usr/local/bin/agentctl handoff"*) _lop=handoff ;;
        esac
        # shellcheck disable=SC2086 # word-splitting one positional is intended
        set -- $pos
        cont=${1:?stub docker: legacy agentctl mutation without a container}
        proj=$(proj_of_container "$cont")
        f="$scene/$proj/exec-agentctl-$_lop-$cont.txt"
        if [ -f "$f" ]; then
          cat "$f"
        else
          stub_fail "stub docker: no recorded reply: add $proj/exec-agentctl-$_lop-$cont.txt"
        fi
        exit 0
        ;;
    esac
    if [ -n "$vol" ]; then
      dd="$vols/$vol"
    else
      # shellcheck disable=SC2086 # word-splitting one positional is intended
      set -- $pos
      cont=${1:?stub docker: $cmd without a container or volume}
      if [ "$cmd" = "run" ]; then
        stub_fail "stub docker: no recorded reply: run without a -v volume"
      fi
      dd=$(datadir_for_container "$cont")
    fi
    [ -d "$dd" ] || {
      stub_fail "stub docker: no fixture data at $dd"
    }
    set +e
    (cd "$dd" && sh -c "$script")
    code=$?
    set -e
    exit "$code"
    ;;
  (cp)
    src=""
    dst=""
    for a in "$@"; do
      case "$a" in
        (-*) ;;
        (*)
          if [ -z "$src" ]; then src=$a; else dst=$a; fi
          ;;
      esac
    done
    cont=${src%%:*}
    rel=${src#*:}
    dd=$(datadir_for_container "$cont")
    case "$rel" in
      (/data/*) ;;
      (*)
        stub_fail "stub docker: no recorded reply: cp of $src"
        ;;
    esac
    rel=${rel#/data/}
    set +e
    cp -r "$dd/$rel" "$dst/"
    code=$?
    set -e
    exit "$code"
    ;;
  (*)
    stub_fail "stub docker: no recorded reply for '$cmd'"
    ;;
esac
