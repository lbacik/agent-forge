# yaml-language-server: $schema=https://raw.githubusercontent.com/lbacik/coding-agent/main/schemas/workflow-v4.schema.json
# Workflow Configuration (`version: 4`) for the coding-agent instance
# dedicated to {{OWNER}}/{{REPO}}. It declares the Workflows the operator
# selected: `implement` (issue in, pull request out), `triage`
# (`needs-triage` in, a triaged issue out), or both. Rendered by the
# create-agent skill from this template; the operator guide is
# coding-agent's docs/ops/workflow-configuration.md, and the step-workflow
# runtime contract is the authority. This file is baked into the derived
# image (see the instance Dockerfile), never mounted: any edit needs
# `docker compose build` before the container is recreated, and the build
# itself re-validates (once per declared Workflow), re-prepares and
# re-verifies the package. Validate edits once per declared Workflow with
#   docker compose run --rm agent config validate \
#     --config /etc/coding-agent/workflow.yml --workflow <id>
# with no secrets set: `config validate` is static, it checks the whole file
# without opening an Attempt or writing to GitHub.
#
# Rendering. The skill keeps the blocks of the selected Workflows and
# deletes the others: every range from `# workflow-implement-begin` through
# `# workflow-implement-end` (two ranges: the `main` pin and the `implement`
# Workflow), and likewise every `workflow-triage-*` range (the `triage` and
# `triage-advisor` pins and the `triage` Workflow). The range from
# `# instance-profile-begin` through `# instance-profile-end` (the
# `target.profile` line) is kept only when the instance supplies its own
# Project Profile (`workflow/project-profile.yml`) and deleted otherwise.
# The marker lines themselves are deleted too. No placeholder may remain.
#
# `version: 2` and `version: 3` files are refused with a migration
# diagnostic (coding-agent 0.4.7 made `version: 4` the only accepted
# format): keep `version: 4` and the `skills:` block below. A missing
# `skills` field means an empty bundle, so every static `skill:` reference
# below names a declared member, and every member needs a reviewed entry in
# the workflow directory's `skill-policy.json`. For the reference bundle
# (`implement` alone) that file is copied verbatim from the
# CODING_AGENT_REF checkout's `docker/deployment/skill-policy.json`; any
# other bundle gets a policy drafted with `agent draft-skill-policy` and
# completed with operator-approved decisions only. The skill writes only
# the decisions the operator approved and never approves on its own; a
# changed membership or source ref means drafting and reviewing again.
#
# One Worker runs one Workflow, named by `--workflow` in its own compose.yaml
# stanza. Editing this file affects the next Attempt, never one already
# open. Values that are credentials never appear here: `target.token-env`
# and each model's `api-key-env` name environment variables only; the
# values live in `.env`. A value that looks like a secret where a name
# belongs fails validation.

version: 4

target:
  kind: github
  repository: {{OWNER}}/{{REPO}}
  base-branch: {{BASE_BRANCH}}
  token-env: GITHUB_TOKEN
  # instance-profile-begin
  # Instance-supplied Project Profile (coding-agent ADR 0030): the file
  # beside workflow.yml replaces the Target Repository's
  # docs/agents/project-profile.yml for every Workflow in this file. It is
  # the Validation Contract of every Workflow that needs one; without this
  # line such a Workflow reads the repository's profile at Worker startup.
  # `config validate` parses it and checks its toolchain against the image's
  # Supported Toolchain Matrix.
  profile: project-profile.yml
  # instance-profile-end

models:
  # Pinned Models, referenced by id. Every pin has exactly one route: its
  # route placeholder (`MAIN_ROUTE`, `TRIAGE_ROUTE`, `ADVISOR_ROUTE`) renders as either
  #   provider: <provider>
  # (a direct pin: the (`provider`, `model`, `endpoint`) triple must come
  # from the code-owned table in coding-agent's
  # `src/coding_agent/provider/config.py` at CODING_AGENT_REF — at v0.5.0
  # `anthropic / claude-sonnet-5 / messages` and
  # `openai / gpt-5.6-luna / responses`), or as
  #   gateway: {kind: litellm, url: <url>}
  # (a Model Gateway pin, coding-agent `docs/ops/workflow-configuration.md`,
  # "Gateway pins": `model` is the gateway's L1 alias, the name it reports
  # in `x-litellm-model-group`; `endpoint` is `responses`; prefer the
  # service name on the shared gateway network, `http://litellm:4000`).
  # Each pin chooses its own route. `effort` is low, medium or high, and on
  # a gateway pin it must be the effort the gateway reports (Meta
  # `muse-spark-1.3-contributor` always runs at `high`). Every pin declares
  # its own `context-window-tokens` (the Model Context Window),
  # `context-threshold-tokens` (the Handoff Threshold) and
  # `output-cap-tokens`: `context-threshold-tokens + output-cap-tokens` must
  # not exceed the window, and the threshold must exceed the code-owned
  # safety margin plus request overhead (1,000 + 1,000). A direct pin
  # defaults them to the upstream recommendation (claude-sonnet-5 1,000,000
  # / 80,000 / 32,000, gpt-5.6-luna 1,050,000 / 100,000 / 32,000); a
  # gateway pin's are always asked. Prices (`prices-usd-per-mtok`: `input`,
  # `output`, `cache-read`, `cache-write`) come from the operator — confirm
  # them (a direct pin's defaults are the code-owned table's public list
  # pricing) — because a pin's configured prices are the Worker's only cost
  # authority. For a Meta model, which has no cache-write premium, set
  # `cache-write` equal to `input` (a gateway response without
  # `cache_write_tokens` is priced at max(`input`, `cache-write`)).
  # workflow-implement-begin
  main:                                 # the `implement` Workflow's Pinned Model
    {{MAIN_ROUTE}}
    model: {{MAIN_MODEL}}
    endpoint: {{MAIN_ENDPOINT}}
    effort: {{MAIN_EFFORT}}
    api-key-env: {{MAIN_API_KEY_ENV}}
    context-window-tokens: {{MAIN_CONTEXT_WINDOW_TOKENS}}
    context-threshold-tokens: {{MAIN_CONTEXT_THRESHOLD_TOKENS}}
    output-cap-tokens: {{MAIN_OUTPUT_CAP_TOKENS}}
    prices-usd-per-mtok: {input: {{MAIN_PRICE_INPUT}}, output: {{MAIN_PRICE_OUTPUT}}, cache-read: {{MAIN_PRICE_CACHE_READ}}, cache-write: {{MAIN_PRICE_CACHE_WRITE}}}
  # workflow-implement-end
  # workflow-triage-begin
  triage:                               # the `triage` Workflow's Pinned Model
    {{TRIAGE_ROUTE}}
    model: {{TRIAGE_MODEL}}
    endpoint: {{TRIAGE_ENDPOINT}}
    effort: {{TRIAGE_EFFORT}}
    api-key-env: {{TRIAGE_API_KEY_ENV}}
    context-window-tokens: {{TRIAGE_CONTEXT_WINDOW_TOKENS}}
    context-threshold-tokens: {{TRIAGE_CONTEXT_THRESHOLD_TOKENS}}
    output-cap-tokens: {{TRIAGE_OUTPUT_CAP_TOKENS}}
    prices-usd-per-mtok: {input: {{TRIAGE_PRICE_INPUT}}, output: {{TRIAGE_PRICE_OUTPUT}}, cache-read: {{TRIAGE_PRICE_CACHE_READ}}, cache-write: {{TRIAGE_PRICE_CACHE_WRITE}}}
  triage-advisor:                       # the `triage` step's Advisor pin (the maintainer proxy)
    {{ADVISOR_ROUTE}}
    model: {{ADVISOR_MODEL}}
    endpoint: {{ADVISOR_ENDPOINT}}
    effort: {{ADVISOR_EFFORT}}
    api-key-env: {{ADVISOR_API_KEY_ENV}}
    context-window-tokens: {{ADVISOR_CONTEXT_WINDOW_TOKENS}}
    context-threshold-tokens: {{ADVISOR_CONTEXT_THRESHOLD_TOKENS}}
    output-cap-tokens: {{ADVISOR_OUTPUT_CAP_TOKENS}}
    prices-usd-per-mtok: {input: {{ADVISOR_PRICE_INPUT}}, output: {{ADVISOR_PRICE_OUTPUT}}, cache-read: {{ADVISOR_PRICE_CACHE_READ}}, cache-write: {{ADVISOR_PRICE_CACHE_WRITE}}}
  # workflow-triage-end

# Skill Bundle membership, one source at one recorded commit. `implement`
# adds the reference deployment's four skills (`implement, tdd,
# code-review, codebase-design`, coding-agent's
# `docker/deployment/workflow.yml` at CODING_AGENT_REF); `triage` adds
# `triage, grilling, domain-modeling` (the triage skill invokes the other
# two). With both Workflows the list carries all seven, `implement`'s
# first. The whole declaration counts as the bundle whatever `--workflow`
# a Worker selects.
skills:
  - source: git+https://github.com/mattpocock/skills.git
    ref: 3cca18b368ae95cdbdebbff572ccafa662551015
    include: [{{SKILL_INCLUDE}}]

worker:
  poll-interval-seconds: 60             # idle sleep between sweeps (spends the owner's rate limit)
  shutdown-grace-seconds: 30            # time to finalise after SIGTERM; keep below compose.yaml's stop_grace_period (60s)

workflows:
  # workflow-implement-begin

  # ---------------------------------------------------------------------------
  # Implementation: issue in, pull request out.
  # Policy expressed here, not in the runtime: readiness first, tests via the
  # Validation Contract, a separate self-review before publishing, a PR only
  # when validation passed on the pushed revision.
  # ---------------------------------------------------------------------------
  implement:
    model: main                         # the Attempt's one Pinned Model
    input:
      type: issue
      label: {{SELECTION_LABEL}}        # Selection Label (human-applied, checked)
      exclude: [ready-for-human, wontfix]
      skip-open-agent-pr: true          # skip an issue whose own agent PR is still open
    limits:                             # Attempt Ceiling (mandatory, all four meters)
      cost-usd: {{LIMIT_COST_USD}}
      effective-tokens: {{LIMIT_EFFECTIVE_TOKENS}}  # excludes prompt-cache reads
      tool-calls: {{LIMIT_TOOL_CALLS}}
      wall-clock-minutes: {{LIMIT_WALL_CLOCK_MINUTES}}
    max-parallel-subagents: 2
    outcomes:                           # end labels per Terminal Outcome (runtime applies them)
      blocked: {labels: [ready-for-human]}
      unfinished: {labels: [ready-for-human]}
      failed: {labels: [ready-for-human]}
      internal-failure: {labels: [ready-for-human]}
      # Runtime-only endings take end labels too. Without them the runtime
      # removes the Selection Label and applies nothing, so the issue drops
      # out of every queue unlabelled. `interrupted` (SIGTERM, process loss
      # settled by startup recovery, pin violation) and `drift` (the input
      # or its base moved under the Attempt) need a human; `withdrawn` is a
      # human's own removal of the label or close, so it gets none.
      interrupted: {labels: [ready-for-human]}
      drift: {labels: [ready-for-human]}

    start: preflight
    defaults:
      max-executions: 1
      routes:                           # only runtime-reserved results may appear here
        error: hard-handoff
        limit-exceeded: hard-handoff

    steps:

      preflight:                                    # role: Preflight
        operation: check-readiness
        routes:
          ready: process
          not-ready: {end: blocked}

      process:                                      # role: Process
        agent:
          instructions:
            - skill: implement
            - prompt: prompts/implement-policy.md
          tools: [workspace-read, workspace-write, shell, tests, subagents]
          inputs:
            - optional: validate.facts              # why the last validation failed
            - optional: self-review.changes-needed.findings
          results:
            done:
              criteria: {list: evidence-ref}        # each test id must have passed on the current tree
              summary: document
            blocked:
              reason: document
        max-executions: 3
        # Step Allowance, shared by all three executions: must fit in the Work
        # Pool (Attempt Ceiling minus the `ai-handoff` reserve, per meter), or
        # validation refuses it.
        limits: {cost-usd: {{PROCESS_LIMIT_COST_USD}}}
        routes:
          done: validate
          blocked: explain-blocked
          limit-exceeded: ai-handoff                # only Process gets the AI-assisted Handoff

      validate:
        operation: run-validation
        max-executions: 3
        routes:
          passed: self-review
          failed: process

      self-review:
        agent:
          instructions:
            - skill: code-review
          tools: [workspace-read, subagents]
          inputs:
            - process.done.summary
          results:
            approved: {}
            changes-needed:
              findings: document
        max-executions: 2
        # Step Allowance: must fit in the Work Pool (see `process` above).
        limits: {cost-usd: {{SELF_REVIEW_LIMIT_COST_USD}}}
        routes:
          approved: push
          changes-needed: process

      push:                                         # role: Finish
        operation: commit-and-push
        routes:
          pushed: open-pr
          no-changes: {end: blocked}

      open-pr:
        operation: open-pull-request              # title: fixed runtime template over the issue title
        with:
          body: process.done.summary
          draft: false
          requires: [run-validation: passed]
        routes:
          opened: {end: completed}
          already-open: {end: completed}
          requirement-unmet: hard-handoff

      explain-blocked:
        operation: post-comment
        with:
          body: process.blocked.reason
        routes:
          posted: {end: blocked}

      ai-handoff:                                   # role: Handoff (AI-assisted)
        agent:
          instructions:
            - prompt: prompts/handoff.md
          tools: [workspace-read]
          inputs:
            - process.facts
          results:
            handoff:
              note: document
        # Reserved Step: a complete allowance carved out of the Attempt Ceiling, so
        # the Work Pool (ceiling minus this reserve, per meter) is smaller than
        # the ceiling on every meter. Every non-reserved Step Allowance
        # (`process`, `self-review`) must fit in that Work Pool, or validation
        # refuses it: the skill checks the fit before writing this file and asks
        # the operator for new allowances or a higher ceiling instead of scaling
        # them itself. Every limit declaring `effective-tokens` or `cost-usd`
        # must also hold one maximal Admission hold: `effective-tokens` >=
        # Usable Threshold (`context-threshold-tokens` - 2,000) +
        # `output-cap-tokens`. The skill renders 150000 here, or that floor
        # when the pin's threshold needs more.
        reserved: true
        limits: {cost-usd: 1, effective-tokens: {{HANDOFF_EFFECTIVE_TOKENS}}, tool-calls: 30, wall-clock-minutes: 5}
        routes:
          handoff: handoff-push

      handoff-push:
        operation: commit-and-push
        routes:
          pushed: handoff-comment
          no-changes: handoff-comment

      handoff-comment:
        operation: post-comment
        with:
          body: ai-handoff.handoff.note
        routes:
          posted: {end: unfinished}

      hard-handoff:                                 # role: Handoff (Hard, no model)
        operation: commit-and-push
        routes:
          pushed: {end: unfinished}
          no-changes: {end: unfinished}
          error: {end: failed}
          limit-exceeded: {end: failed}             # must override the default (no self-cycle)
  # workflow-implement-end
  # workflow-triage-begin

  # ---------------------------------------------------------------------------
  # Triage: `needs-triage` in, a triaged issue out (requires CODING_AGENT_REF
  # v0.5.1 or newer: `input.comments` and the `advisor` tool group arrived in
  # v0.5.0, and from v0.5.1 a Workflow that never validates runs without a
  # Project Profile).
  # One agent step runs the `triage` skill with the policy prompt that
  # answers the skill's interactive parts; the maintainer's questions go to
  # the Advisor. Every result posts its document, commits and pushes what
  # the skill wrote (`CONTEXT.md`, ADRs, `.out-of-scope/`), and opens a
  # draft pull request with the same document, so the runtime writes the
  # non-closing `Part of #N`. No `check-readiness`, no `run-validation` and
  # no `tests` tool group: triage changes no code, so it needs no Validation
  # Contract and runs without a Project Profile. Re-triage happens when a
  # human swaps `needs-info` back to `needs-triage`; `input.comments` then
  # carries the earlier notes and the reporter's answers.
  # ---------------------------------------------------------------------------
  triage:
    model: triage                       # the Attempt's Pinned Model
    input:
      type: issue
      label: needs-triage               # Selection Label (human-applied, checked)
      exclude: [needs-info, ready-for-human, wontfix]
    limits:                             # Attempt Ceiling (mandatory, all four meters)
      # No Reserved Step here, so the Work Pool is the whole ceiling. Each
      # limit must hold one maximal Admission hold for the triage pin and
      # for the Advisor pin, whichever needs more (config validate names the
      # pin it measured).
      cost-usd: {{TRIAGE_LIMIT_COST_USD}}
      effective-tokens: {{TRIAGE_LIMIT_EFFECTIVE_TOKENS}}  # excludes prompt-cache reads
      tool-calls: {{TRIAGE_LIMIT_TOOL_CALLS}}
      wall-clock-minutes: {{TRIAGE_LIMIT_WALL_CLOCK_MINUTES}}
    outcomes:                           # end labels per Terminal Outcome (runtime applies them)
      completed: {labels: [ready-for-agent]}
      blocked: {labels: [needs-info]}
      unfinished: {labels: [ready-for-human]}
      failed: {labels: [ready-for-human]}
      internal-failure: {labels: [ready-for-human]}
      # Runtime-only endings: `interrupted` and `drift` need a human;
      # `withdrawn` (a human removed the label or closed the issue) gets
      # none. Without these the issue drops out of every queue unlabelled.
      interrupted: {labels: [ready-for-human]}
      drift: {labels: [ready-for-human]}

    start: triage
    defaults:
      max-executions: 1
      routes:                           # only runtime-reserved results may appear here
        error: hard-handoff
        limit-exceeded: hard-handoff

    steps:

      triage:                                       # role: Process
        agent:
          instructions:
            - skill: triage
            - prompt: prompts/triage-policy.md
          tools: [workspace-read, workspace-write, shell, advisor]
          advisor: {model: triage-advisor, prompt: prompts/triage-advisor.md}
          inputs:
            - input.comments                        # Trusted Comments pinned at Claim, oldest first
          results:
            ready:                                  # -> ready-for-agent
              brief: document
            blocked:                                # -> needs-info
              notes: document
            human:                                  # -> ready-for-human (also wontfix / already implemented)
              recommendation: document
        routes:
          ready: post-brief
          blocked: post-notes
          human: post-recommendation

      post-brief:
        operation: post-comment
        with:
          body: triage.ready.brief
        routes:
          posted: push-brief

      push-brief:
        operation: commit-and-push
        routes:
          pushed: open-brief-pr
          no-changes: {end: completed}

      open-brief-pr:
        operation: open-pull-request              # draft: the runtime writes `Part of #N`, never `Closes #N`
        with:
          body: triage.ready.brief
          draft: true
        routes:
          opened: {end: completed}
          already-open: {end: completed}

      post-notes:
        operation: post-comment
        with:
          body: triage.blocked.notes
        routes:
          posted: push-notes

      push-notes:
        operation: commit-and-push
        routes:
          pushed: open-notes-pr
          no-changes: {end: blocked}

      open-notes-pr:
        operation: open-pull-request
        with:
          body: triage.blocked.notes
          draft: true
        routes:
          opened: {end: blocked}
          already-open: {end: blocked}

      post-recommendation:
        operation: post-comment
        with:
          body: triage.human.recommendation
        routes:
          posted: push-recommendation

      push-recommendation:
        operation: commit-and-push
        routes:
          pushed: open-recommendation-pr
          no-changes: {end: unfinished}

      open-recommendation-pr:
        operation: open-pull-request
        with:
          body: triage.human.recommendation
          draft: true
        routes:
          opened: {end: unfinished}
          already-open: {end: unfinished}

      hard-handoff:                                 # role: Handoff (Hard, no model)
        # Every `error` and `limit-exceeded` above lands here: push whatever
        # the skill wrote and end `unfinished` (ready-for-human). There is no
        # AI-assisted Handoff in this Workflow, so no Reserved Step.
        operation: commit-and-push
        routes:
          pushed: {end: unfinished}
          no-changes: {end: unfinished}
          error: {end: failed}
          limit-exceeded: {end: failed}             # must override the default (no self-cycle)
  # workflow-triage-end
