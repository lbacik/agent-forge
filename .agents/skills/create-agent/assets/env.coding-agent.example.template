# Copy to .env and fill in before `docker compose up --build -d worker`.
# Credentials below are names the Workflow Configuration (`workflow/workflow.yml`)
# refers to: `target.token-env` and `models.<id>.api-key-env`. Values live only
# here, never in the YAML. Upstream reference: coding-agent's compose.yaml and
# docs/ops/workflow-configuration.md at CODING_AGENT_REF.

# Fine-grained PAT with access to {{OWNER}}/{{REPO}} (contents,
# pull-requests, issues: read & write). Named by the Workflow Configuration's
# `target.token-env`.
GITHUB_TOKEN=
# The Target Repository. The Worker reads it from `workflow/workflow.yml`
# (`target.repository`); it is repeated here so the Fleet check and the
# wrong-instance guard (`--expect-repo`) can read it without parsing YAML.
# Never compare or print the tokens of two files: see the create-agent skill.
TARGET_REPO={{OWNER}}/{{REPO}}

# Which commit of https://github.com/lbacik/coding-agent the image builds
# from (branch, tag, or commit SHA; see compose.yaml's build context).
# Default main tracks upstream; pin a tag to freeze the agent's code, then
# `docker compose build` to rebuild against it — no other file needs editing.
# The toolchain (the image's Supported Toolchain Matrix) follows the same
# ref. Checked by the create-agent skill against the target's Project
# Profile before scaffolding.
CODING_AGENT_REF={{CODING_AGENT_REF}}

# Model credential: set the one the Workflow Configuration names in
# `models.<id>.api-key-env`; leave the other commented out. Which pair the
# ref supports is code-owned (coding-agent `src/coding_agent/provider/config.py`):
# at the documented ref, `anthropic / claude-sonnet-5 / messages` and
# `openai / gpt-5.6-luna / responses`.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Which Workflow of workflow.yml the worker runs (default `implement`).
# Only `implement` is rendered; uncomment only to run another id after adding
# it to the YAML.
# WORKFLOW=implement
# Directory holding workflow.yml (and any prompt files it names), mounted
# read-only at /etc/coding-agent. Uncomment only to keep it elsewhere.
# WORKFLOW_CONFIG_DIR=./workflow
# Checkout a `validate` run checks against its own Project Profile.
# Uncomment and point at a target checkout when offered that run; there is no
# usable default (see compose.yaml).
# TARGET_PROJECT=
