# Deploys one coding-agent instance dedicated to {{OWNER}}/{{REPO}}.
#
# The Worker runs from a derived deployment image (this directory's
# Dockerfile, built FROM the engine image through the `engine` context
# below), following the "External builders: the Agent Forge sequence" in
# coding-agent's docs/ops/workflow-configuration.md (read at v0.4.0). The
# instance's `workflow/` package (workflow.yml, prompts/ and the reviewed
# skill-policy.json) is baked into that image and verified there
# (`config validate`, then `prepare-skill-bundle --mode install`, then
# `verify-skill-bundle` against the final roots), so the Worker starts with
# the full v3 `run` invocation and the build — not startup — fails on a
# mismatch. Change CODING_AGENT_REF and rebuild to switch agent code; any
# edit under `workflow/` needs `docker compose build` before the container
# is recreated (the same rule as a profile change for simple-coding-agent).
# Nothing here needs editing either way.
#
# Build arrangement: the `engine` service builds the `deployment` target of
# the coding-agent git repository at the ref named by CODING_AGENT_REF in
# .env (default main) — that target already carries the Target Project
# toolchains and the generated Supported Toolchain Matrix (coding-agent ADR
# 0001), never per instance. The derived services build FROM it through an
# `additional_contexts` entry with a `service:` source, so one
# `docker compose up --build -d worker` builds the base first with no extra
# step and no shared image tag to clash with another instance on the same
# context. The `service:` source is part of `additional_contexts`, which
# needs Compose 2.17 or newer — the same minimum the simple-coding-agent
# template already requires — and `docker compose config` resolves it
# client-side, so render-check covers it with no daemon. An image tag
# instead (the derived Dockerfile naming a prebuilt base tag) would need a
# separate prior build step and a per-instance tag; the `service:`
# reference keeps the ordering inside Compose.
#
# The Compose project is the directory name: this file deliberately sets no
# `name:` (coding-agent's own fixed `name: coding-agent` is not copied),
# because the project name is the Instance identity on this Docker context.
#
# Services: `worker` (and `worker-2` in a two-Worker Pool) is a
# long-running process (`agent run` with the full v3 flags) and a Managed
# Instance, so the Worker services alone carry the contract discovery
# labels. `agent` and `validate` are unlabelled one-off
# seats (`docker compose run --rm ...`) on the same derived image, so
# `validate` and `startup-check` see the same toolchains and the same baked
# package as the Workers. `engine` is the build-only base image (never run,
# never labelled). So that a bare `docker compose up -d` starts the Workers
# alone, `engine` has `scale: 0` and `agent` and `validate` sit in the
# `tools` profile. Naming a service (`docker compose run --rm validate`)
# enables its profile, so the one-off commands need no `--profile` flag.
# `engine` cannot take a profile instead: a profile left inactive drops it
# from the model, the `service:engine` build context no longer resolves, and
# every command fails, even `docker compose config`. `scale: 0` keeps it in
# the model, so it is still built, but Compose creates no container for it.
# `docker compose config --services` therefore lists `engine` and the
# Worker services; add `--profile '*'` to see the one-off seats too.
#
# Workers and Workflows: every Worker runs exactly one Workflow of
# workflow.yml, named by `--workflow` in its own stanza, and has its own
# state volume (`state`, `state_2`). A Pool holds at most one Worker per
# Workflow, so at most two Workers (`implement` and `triage`): this backend
# never advertises the `pool` Operator Capability and leaves no Claim
# marker, so two Workers on one Workflow would race on one Queue
# (docs/adr/0005). `manage-pool` adds or removes the second Worker. A
# Target Repository holds at most one coding-agent Instance; an Instance of
# another backend may share it (docs/adr/0003).
#
# Hardening mirrors coding-agent's own deployment (its compose.yaml at the
# chosen ref): read-only root filesystem with a writable /tmp on every
# service, `init: true` plus `restart: "no"` on every Worker (a startup refusal
# or a Halt exits non-zero and is never restarted automatically, so a
# Credential Failure cannot loop), and `stop_grace_period` above the
# Workflow Configuration's `worker.shutdown-grace-seconds` (default 30 s),
# or Docker would SIGKILL the Worker mid-finalisation.

# Everything the derived services share. Each merges it with `<<: *agent`.
#
# `build.args.WORKFLOWS` lists the Workflow ids workflow.yml declares
# (`implement`, `triage`, or both, space-separated): the Dockerfile runs the
# static `config validate` once per id at build time.
x-agent: &agent
  # Runtime settings for the container. Values come from the shell or from
  # the .env compose reads beside this file for interpolation. GITHUB_TOKEN
  # is the default the CLI looks for; SANDBOX_TOKEN is passed through so a
  # sandbox credential can be selected with `--token-env SANDBOX_TOKEN`
  # rather than copied under a second name. The model key variables
  # (ANTHROPIC_API_KEY or OPENAI_API_KEY for a direct pin,
  # LITELLM_PROXY_API_KEY for a gateway pin — whichever the Workflow
  # Configuration names in `models.<id>.api-key-env`) reach only the
  # Worker services below, each Worker the keys of its own pins. There is deliberately no `env_file:` (as in upstream's
  # compose.yaml): it would copy every .env key, the model key included,
  # into the `agent` and `validate` seats too. Secret-free `config validate`
  # needs no environment, and `startup-check` needs only GITHUB_TOKEN.
  build:
    context: .
    dockerfile: Dockerfile
    # The engine base image, built by the `engine` service below from the
    # coding-agent git repository at CODING_AGENT_REF. A `service:` source
    # makes Compose build it as part of building these services.
    additional_contexts:
      engine: service:engine
    args:
      WORKFLOWS: "{{WORKFLOWS}}"
  image: coding-agent:{{SHORT_NAME}}
  # The image deliberately declares no entrypoint (its verification scripts
  # run `bash` inside it); compose fixes one so a service's arguments read
  # as the agent's own subcommand.
  entrypoint: ["agent"]
  read_only: true
  tmpfs:
    - /tmp
  # Per-Worker resource limits, overridable in .env. A Worker mostly waits on
  # the model, with bursts during setup and checks (agent-forge#22). The 3g
  # memory default is unverified: a Worker's peak memory has not been
  # measured. Raise it for a target whose setup or tests need more.
  cpus: ${WORKER_CPUS:-1.5}
  mem_limit: ${WORKER_MEM_LIMIT:-3g}
  pids_limit: ${WORKER_PIDS_LIMIT:-1024}
  environment:
    GITHUB_TOKEN: ${GITHUB_TOKEN:-}
    SANDBOX_TOKEN: ${SANDBOX_TOKEN:-}
  volumes:
    - state:/var/lib/coding-agent

services:
  # The build-only engine base image: the `deployment` target of the
  # coding-agent git repository at CODING_AGENT_REF (default main), carrying
  # the toolchains and the generated Supported Toolchain Matrix the derived
  # image builds FROM. Never run and never labelled: it exists so the
  # derived services above resolve their `engine` build context. Rebuilt
  # automatically as part of `docker compose build` and of
  # `docker compose up --build -d worker`. `scale: 0` keeps it out of a bare
  # `docker compose up -d`. It must not take a profile: that would remove it
  # from the model and break the `service:engine` build context (see the
  # header).
  engine:
    scale: 0
    build:
      context: https://github.com/lbacik/coding-agent.git#${CODING_AGENT_REF:-main}
      target: deployment
    image: coding-agent-engine:{{SHORT_NAME}}

  # The general-purpose seat. Everything the CLI can do, with the
  # subcommand supplied at the command line:
  #
  #   docker compose run --rm agent startup-check --repo {{OWNER}}/{{REPO}}
  #   docker compose run --rm agent config validate --config /etc/coding-agent/workflow.yml --workflow <id>
  #
  # (once per Workflow id workflow.yml declares).
  #
  # The Workflow Configuration and its Skill Bundle are baked into this
  # image (see the Dockerfile), so commands that read them need no mount
  # and no secrets set: `config validate` is static. Never labelled: one-off
  # containers are never Managed Instances. In the `tools` profile, so a bare
  # `docker compose up -d` skips it; `docker compose run --rm agent ...`
  # names it and needs no `--profile`.
  agent:
    <<: *agent
    profiles: [tools]
    command: ["--help"]

  # Validates one checkout against its own Project Profile. Point it at the
  # checkout (mounted writable, because `bootstrap` installs into it);
  # evidence is written to the state volume, not into the project:
  #
  #   TARGET_PROJECT=../my-project docker compose run --rm validate
  #   TARGET_PROJECT=../my-project docker compose run --rm validate --skip-bootstrap \
  #     --targeted tests/test_greeting.py
  #
  # TARGET_PROJECT has no usable default: `./target` only satisfies
  # interpolation so that `docker compose config` passes with nothing set.
  # Always set it to a real checkout when running this service. The two
  # paths sit in the entrypoint rather than in `command` so that arguments
  # given to `docker compose run` are appended to them instead of replacing
  # them. Never labelled: a one-off seat, not a Managed Instance. In the
  # `tools` profile, like `agent`.
  validate:
    <<: *agent
    profiles: [tools]
    volumes:
      - state:/var/lib/coding-agent
      - ${TARGET_PROJECT:-./target}:/var/lib/coding-agent/workspaces/target
    # The two paths sit in the entrypoint rather than in `command` so that
    # arguments given to `docker compose run` are appended to them instead
    # of replacing them.
    entrypoint:
      - agent
      - validate
      - --project-dir
      - /var/lib/coding-agent/workspaces/target
      - --evidence-dir
      - /var/lib/coding-agent/artifacts/target
    command: []

  # The first Worker (step-workflow contract §4): `agent run` against the
  # baked `version: 4` Workflow Configuration at
  # /etc/coding-agent/workflow.yml, with the baked prompts, reviewed
  # skill-policy.json, prepared bundle records and Supported Toolchain
  # Matrix the derived image carries. It selects, claims and runs its
  # Workflow's inputs one Attempt at a time until it halts.
  #
  #   docker compose up -d worker
  #
  # `--workflow` names this Worker's Workflow (`implement` or `triage`, one
  # that workflow.yml declares): the Worker's own configuration, changed by
  # editing it here and recreating the container (no rebuild). The token
  # variable the YAML's `target.token-env` names and the `api-key-env` of
  # every pin this Worker uses (its Workflow's pin, plus the Advisor pin
  # for `triage`) must be among the names passed below. Only the Worker
  # services are labelled: the deployment labels make these containers —
  # and only these — Managed Instances. They are set through the
  # deployment, never as an image LABEL: the image is shared with the
  # one-off `agent` and `validate` services above.
  worker:
    <<: *agent
    restart: "no"
    # Contract discovery labels (operator contract §2.1): contract major 1,
    # this Worker's Managed Instance name (`<short-name>` for the first
    # Worker), the non-root exec user the engine image runs as, and this
    # backend. The name must match `^[a-z0-9][a-z0-9-]{0,62}$`.
    labels:
      io.github.lbacik.agent-operator.contract: "1"
      io.github.lbacik.agent-operator.instance: {{SHORT_NAME}}
      io.github.lbacik.agent-operator.exec-user: "agent"
      io.github.lbacik.agent-operator.backend: "coding-agent"
    # PID 1 in the image ignores SIGTERM without an installed handler, so
    # the Worker installs one explicitly at startup and this init forwards
    # the signal as well. `stop_grace_period` must stay above the Workflow
    # Configuration's `worker.shutdown-grace-seconds` (default 30 s), or
    # Docker would SIGKILL the Worker mid-finalisation.
    init: true
    stop_grace_period: 60s
    environment:
      GITHUB_TOKEN: ${GITHUB_TOKEN:-}
      SANDBOX_TOKEN: ${SANDBOX_TOKEN:-}
      # Model keys: keep exactly the variables this Worker's pins name in
      # `api-key-env` and delete the other lines (no other service gets
      # them).
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY:-}
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      LITELLM_PROXY_API_KEY: ${LITELLM_PROXY_API_KEY:-}
    volumes:
      - state:/var/lib/coding-agent
    # The operator control socket directory: a tmpfs mount shadowing the
    # state volume's `operator` subdirectory, so the Unix socket never
    # touches the named volume. Only the Worker services carry it; `agent`
    # and `validate` keep the base `/tmp` tmpfs alone. The listener enforces
    # 0700 on the directory and 0600 on the socket; there is no network
    # listener and no published port. If the chosen CODING_AGENT_REF's
    # `agentctl` documents no such socket directory, drop this second entry
    # (see the create-agent skill, references/coding-agent.md).
    # The mount options make Docker create the directory owned by the
    # engine image's `agent` user (uid/gid 1000, the same user the
    # `io.github.lbacik.agent-operator.exec-user` label names): a plain
    # tmpfs arrives root:root 1777 and the Worker (running as `agent`)
    # cannot chmod it to 0700, so startup refuses the socket bind. The
    # numbers are hard-coded; change them if the upstream image changes
    # that user's ids.
    tmpfs:
      - /tmp
      - /var/lib/coding-agent/operator:uid=1000,gid=1000,mode=0700
    command:
      - run
      - --config
      - /etc/coding-agent/workflow.yml
      - --workflow
      - {{WORKER_WORKFLOW}}
      - --state-dir
      - /var/lib/coding-agent
      - --toolchain-matrix
      - /opt/coding-agent/toolchain-matrix.json
      - --policy
      - /etc/coding-agent/skill-policy.json
      - --bundle-dir
      - /opt/coding-agent/skill-bundle
      - --skill-home
      - /home/agent
  # worker-2-begin

  # The second Worker, only in a two-Worker Pool (one Worker per Workflow,
  # docs/adr/0005): the same stanza as `worker`, with its own Managed
  # Instance name `<short-name>-2`, its own state volume `state_2`, its own
  # `--workflow` (the Workflow `worker` does not run) and the model keys of
  # its own pins. Delete from worker-2-begin through worker-2-end (and the
  # `state_2` volume below) for a single Worker. Comments on `worker`
  # apply here too.
  #
  #   docker compose up -d worker-2
  worker-2:
    <<: *agent
    restart: "no"
    labels:
      io.github.lbacik.agent-operator.contract: "1"
      io.github.lbacik.agent-operator.instance: {{SHORT_NAME}}-2
      io.github.lbacik.agent-operator.exec-user: "agent"
      io.github.lbacik.agent-operator.backend: "coding-agent"
    init: true
    stop_grace_period: 60s
    environment:
      GITHUB_TOKEN: ${GITHUB_TOKEN:-}
      SANDBOX_TOKEN: ${SANDBOX_TOKEN:-}
      # Model keys: keep exactly the variables this Worker's pins name.
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY:-}
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      LITELLM_PROXY_API_KEY: ${LITELLM_PROXY_API_KEY:-}
    volumes:
      - state_2:/var/lib/coding-agent
    tmpfs:
      - /tmp
      - /var/lib/coding-agent/operator:uid=1000,gid=1000,mode=0700
    command:
      - run
      - --config
      - /etc/coding-agent/workflow.yml
      - --workflow
      - {{WORKER_2_WORKFLOW}}
      - --state-dir
      - /var/lib/coding-agent
      - --toolchain-matrix
      - /opt/coding-agent/toolchain-matrix.json
      - --policy
      - /etc/coding-agent/skill-policy.json
      - --bundle-dir
      - /opt/coding-agent/skill-bundle
      - --skill-home
      - /home/agent
  # worker-2-end

volumes:
  state:
  # worker-2-begin
  state_2:
  # worker-2-end
